# Reverse proxy local (supabase/docker/docker-compose.local.yml)

# Front : `yarn dev` (Vite, port 5173) directement sur la machine hôte
starbreakers.localhost {
	reverse_proxy host.docker.internal:5173
}

# Supabase : passerelle officielle (Envoy) - /auth/v1, /rest/v1, /realtime/v1, /storage/v1,
# et Studio sur / (basic-auth DASHBOARD_USERNAME / DASHBOARD_PASSWORD)
api.starbreakers.localhost {
	reverse_proxy api-gw:8000
}

# Mailpit : mails envoyés par GoTrue en local
mail.starbreakers.localhost {
	reverse_proxy mailpit:8025
}
