############
# Front (Vite) : connexion à Supabase
#
# La stack Supabase a son propre .env : supabase/docker/.env (modèle officiel supabase/docker/.env.example).
# Reprendre ici l'URL publique de l'API (SUPABASE_PUBLIC_URL) et la clé SUPABASE_PUBLISHABLE_KEY.
# En staging/prod, ces valeurs sont passées au build de l'image (docker-compose.front.yml).
############
VITE_SUPABASE_URL=https://api.starbreakers.localhost
VITE_SUPABASE_PUBLISHABLE_KEY=change_me_publishable_key

############
# Staging/prod uniquement (application Dokploy du front) : port publié sur l'IP du bridge Docker,
# upstream Ingressi http://host.docker.internal:<FRONT_HTTP_PORT>. Un port par environnement.
############
#FRONT_HTTP_PORT=9081
