############
# Domaines (toutes les URL de la stack en dérivent, voir docker-compose.yml)
# Local : starbreakers.localhost / api.starbreakers.localhost (Caddy, voir caddy/Caddyfile)
############
APP_DOMAIN=starbreakers.localhost
API_DOMAIN=api.starbreakers.localhost

############
# Secrets Supabase : à générer pour chaque environnement avec
#   node backend/generate-keys.js
# Le service `migrations` refuse de démarrer si l'un d'eux vaut encore change_me_… ou est vide.
# https://supabase.com/docs/guides/self-hosting/docker#configuring-and-securing-supabase
############

POSTGRES_PASSWORD=change_me_postgres_password

# Secret HS256 partagé par auth/rest/db (32 caractères minimum)
JWT_SECRET=change_me_jwt_secret_at_least_32_characters_long

# Clés API legacy (JWT HS256 signés avec JWT_SECRET). SERVICE_ROLE_KEY peut rester vide.
ANON_KEY=change_me_anon_key
SERVICE_ROLE_KEY=

# Accès au dashboard Studio (basic-auth de Kong)
DASHBOARD_USERNAME=change_me_dashboard_username
DASHBOARD_PASSWORD=change_me_dashboard_password

# Chiffrement des métadonnées de connexion utilisées par Studio/postgres-meta
PG_META_CRYPTO_KEY=change_me_pg_meta_crypto_key_32c

############
# Front-end - client Supabase
# Après les secrets : Vite et Docker Compose résolvent ${…} dans l'ordre du fichier.
############
VITE_API_URL="https://${API_DOMAIN}"
VITE_API_ANON_KEY="${ANON_KEY}"

############
# Auth (GoTrue)
############

# Local : true, pas besoin de cliquer sur le lien de confirmation à l'inscription. Tous les mails
#   (mot de passe oublié, changement d'email…) arrivent dans Mailpit : https://mail.starbreakers.localhost
#   Passer à false pour tester le parcours réel : avec l'autoconfirm, GoTrue ne demande pas non plus
#   la double confirmation (ancienne + nouvelle adresse) lors d'un changement d'email.
# Staging/Prod : false (SMTP OVH, voir ci-dessous)
ENABLE_EMAIL_AUTOCONFIRM=true

# SMTP OVH (staging/prod). En local, docker-compose.dev.yaml redirige tout vers Mailpit.
# Port 465 (SSL) ou 587 (STARTTLS). L'expéditeur n'a pas besoin de boîte aux lettres.
GOTRUE_SMTP_HOST=ssl0.ovh.net
GOTRUE_SMTP_PORT=465
GOTRUE_SMTP_USER=change_me_smtp_user
GOTRUE_SMTP_PASS=change_me_smtp_password
GOTRUE_SMTP_ADMIN_EMAIL=noreply@starbreakers.net
