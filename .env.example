############
# Domaines
############
APP_DOMAIN=example.localhost
API_DOMAIN=api.example.localhost
APP_PORT=8081
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

############
# Front-end - Supabase client
############
VITE_API_URL="https://${API_DOMAIN}"
VITE_API_ANON_KEY=

############
# Secrets Supabase
# https://supabase.com/docs/guides/self-hosting/docker#configuring-and-securing-supabase
############

POSTGRES_PASSWORD=change_me_postgres_password

# JWT signé HS256, partagé par auth/rest/db (32 caractères minimum)
JWT_SECRET=change_me_jwt_secret_at_least_32_characters_long

# Clés API legacy (HS256-signed JWTs), signées avec JWT_SECRET ci-dessus
ANON_KEY=
SERVICE_ROLE_KEY=

# Accès au dashboard Studio (protégé par le plugin basic-auth de Kong)
DASHBOARD_USERNAME=change_me_dashboard_username
DASHBOARD_PASSWORD=change_me_dashboard_password

# Chiffrement des métadonnées de connexion utilisées par Studio/postgres-meta
PG_META_CRYPTO_KEY=change_me_pg_meta_crypto_key_32c

############
# Auth (GoTrue)
############

# Local : true (pas de SMTP, la confirmation planterait à l'inscription)
# Staging/Prod : false (SMTP branché sur le serveur mail OVH (MX), voir ci-dessous)
ENABLE_EMAIL_AUTOCONFIRM=true

# SMTP (uniquement nécessaire en Staging/Prod - serveur mail OVH, pas de self-host)
# Host/port à adapter selon l'offre OVH (voir l'espace client OVH > Emails > Options > Configurer mon logiciel de messagerie)
GOTRUE_SMTP_HOST=mx1.example.net
GOTRUE_SMTP_PORT=587
GOTRUE_SMTP_USER=change_me_smtp_user
GOTRUE_SMTP_PASS=change_me_smtp_password
GOTRUE_SMTP_ADMIN_EMAIL=noreply@example.net